[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]
macos.debug = "res://addons/estragon/bin/libestragon_godot.dylib"
macos.release = "res://addons/estragon/bin/libestragon_godot.dylib"
linux.debug.x86_64 = "res://addons/estragon/bin/libestragon_godot.so"
linux.release.x86_64 = "res://addons/estragon/bin/libestragon_godot.so"
windows.debug.x86_64 = "res://addons/estragon/bin/estragon_godot.dll"
windows.release.x86_64 = "res://addons/estragon/bin/estragon_godot.dll"
